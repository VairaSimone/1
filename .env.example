# Asami is private by default.
# Access the web UI through an SSH tunnel:
# ssh -L 8080:127.0.0.1:8080 asami@YOUR_VPS_IP
# then open http://localhost:8080

# Frontend HTTP Basic Authentication password.
# Username is fixed to: asami
ASAMI_FRONTEND_PASSWORD=change-me

# MySQL root password used by the backend during first-time schema initialization.
MYSQL_ROOT_PASSWORD=change-me

# Optional backend CORS override. Same-origin deployment normally does not need this.
CORS_ORIGIN=*

# Accelerated-simulation Gemini budget. Real daily/monthly caps remain hard limits.
GEMINI_AUTONOMY_SIMULATION_DAY_BUDGET_USD=0.15
GEMINI_AUTONOMY_SIMULATION_DAY_MAX_REQUESTS=50

# Retention catch-up activates on backlog/debt pressure and remains active until recovery.
RETENTION_CATCH_UP_ENTER_BACKLOG=5000
RETENTION_CATCH_UP_EXIT_BACKLOG=1000
RETENTION_CATCH_UP_ENTER_DEBT_AGE_HOURS=24
RETENTION_CATCH_UP_EXIT_DEBT_AGE_HOURS=6

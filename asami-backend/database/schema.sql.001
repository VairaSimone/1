DROP TABLE IF EXISTS `need_definitions`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `need_definitions` (
  `id` binary(16) NOT NULL,
  `code` varchar(50) NOT NULL,
  `name` varchar(100) NOT NULL,
  `min_value` decimal(8,5) NOT NULL DEFAULT '0.00000',
  `max_value` decimal(8,5) NOT NULL DEFAULT '1.00000',
  `default_value` decimal(8,5) NOT NULL DEFAULT '0.50000',
  `decay_rate` decimal(8,5) NOT NULL DEFAULT '0.10000',
  `recovery_rate` decimal(8,5) NOT NULL DEFAULT '0.10000',
  `priority_weight` decimal(8,5) NOT NULL DEFAULT '1.00000',
  `parameters` json DEFAULT NULL,
  `active` tinyint(1) NOT NULL DEFAULT '1',
  PRIMARY KEY (`id`),
  UNIQUE KEY `uq_need_definitions_code` (`code`),
  KEY `idx_need_definitions_active` (`active`),
  CONSTRAINT `chk_need_definitions_code` CHECK ((`code` <> _utf8mb4'')),
  CONSTRAINT `chk_need_definitions_decay` CHECK ((`decay_rate` >= 0.00000)),
  CONSTRAINT `chk_need_definitions_default` CHECK (((`default_value` >= `min_value`) and (`default_value` <= `max_value`))),
  CONSTRAINT `chk_need_definitions_max` CHECK ((`max_value` > `min_value`)),
  CONSTRAINT `chk_need_definitions_name` CHECK ((`name` <> _utf8mb4'')),
  CONSTRAINT `chk_need_definitions_priority` CHECK ((`priority_weight` >= 0.00000)),
  CONSTRAINT `chk_need_definitions_recovery` CHECK ((`recovery_rate` >= 0.00000))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
